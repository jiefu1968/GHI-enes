# ── Primary AI provider (required) ──
# Cerebras by default — chosen for speed. Quiz/case-study generation
# needs a lot of output tokens, and Cerebras's wafer-scale inference
# runs gpt-oss-120b at ~1,600-3,000 tokens/sec — the fastest benchmarked
# provider for this model by a wide margin (Together AI, used here
# previously, ran the same model at only ~600 tokens/sec, which is what
# made quiz/case generation feel slow). Get a key at https://cloud.cerebras.ai
PRIMARY_API_KEY=your-cerebras-key-here

# Endpoint for the provider above. Cerebras's is filled in here by
# default — change only if you switch providers again.
PRIMARY_BASE_URL=https://api.cerebras.ai/v1/chat/completions

# Model name for the provider above.
PRIMARY_MODEL=gpt-oss-120b
# Smaller/cheaper fallback model, tried automatically if the primary one
# hits a rate limit. Cerebras's public tier only offers gpt-oss-120b, so
# this is the same model — see the note in lib/env.ts if that changes.
PRIMARY_MODEL_FALLBACK=gpt-oss-120b

# Model used ONLY by the routing supervisor and the critic/QA pass — cheap
# JSON classification calls, not the main answer. Defaults to
# PRIMARY_MODEL_FALLBACK (i.e. previous behavior) when unset. Point it at a
# genuinely smaller model if your provider has one, to actually realize the
# cost/latency saving these two passes are designed for. Example with a
# Together AI key wired in: SUPERVISOR_CRITIC_MODEL=openai/gpt-oss-20b
SUPERVISOR_CRITIC_MODEL=gpt-oss-120b

# ── Optional third-tier fallback ──
# Together AI by default — separate hardware/quota/company from the
# primary provider above, and reliable even though it's slower for this
# specific model (fine for an occasionally-hit fallback path). Get a key
# at https://www.together.ai
FALLBACK_API_KEY=your-together-ai-key-here
FALLBACK_BASE_URL=https://api.together.ai/v1/chat/completions
FALLBACK_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL_FALLBACK=openai/gpt-oss-20b

# ── Access codes ──
ACCESS_CODE=harvest2026
MENTOR_ACCESS_CODE=mentor2026

# ── Multi-agent architecture upgrades (both default ON; set to "false" to
# instantly roll back, no redeploy of code needed) ──
# ENABLE_SUPERVISOR: LLM-based routing classifier ahead of the keyword
# router, for ambiguous free-text messages (see lib/supervisor.ts).
ENABLE_SUPERVISOR=true
# ENABLE_CRITIC: post-generation QA/reflection pass with one automatic
# repair attempt before a response reaches the user (see lib/critic.ts).
# Trades live token-by-token streaming for a guardrail/bilingual-compliance
# guarantee — see callAgentStreamWithCritic in lib/groq.ts.
ENABLE_CRITIC=true

# ── Hybrid RAG (BM25 + pgvector) — OPT-IN, off by default ──
# With this off, retrieval is exactly the original pure-BM25 behavior.
# Turn it on ONLY after: (1) setting an embedding provider below, (2)
# confirming your Postgres has the pgvector extension available, and (3)
# running the one-time reindex:  POST /api/admin/reindex  (see REINDEX_TOKEN).
ENABLE_HYBRID_RAG=false
# Any OpenAI-compatible /v1/embeddings endpoint. Use a MULTILINGUAL model —
# cross-lingual recall (PT/ES/中文 query vs. English source) is the whole
# point of adding vectors here. Leave EMBEDDING_MODEL blank to keep the
# hybrid path inert even if the flag is on.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.together.ai/v1/embeddings
# Examples to consider (verify your provider actually serves it, and that
# EMBEDDING_DIM below matches its output dimension):
#   BAAI/bge-m3                         (multilingual, dim 1024)
#   intfloat/multilingual-e5-large      (multilingual, dim 1024)
EMBEDDING_MODEL=
# MUST equal the embedding model's output dimension. The pgvector column is
# created at this size on first reindex and does NOT auto-migrate if changed.
EMBEDDING_DIM=1024
# Reciprocal Rank Fusion constant (standard default; rarely changed).
RRF_K=60
# Shared secret protecting POST /api/admin/reindex. If unset, that route is
# disabled (503). Use a long random value: `openssl rand -base64 32`.
REINDEX_TOKEN=

# ── Session signing secret — set a long random value in production ──
# e.g. `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-real-random-secret

# ── Postgres (mentor dashboard persistence) ──
# Any Postgres works: Vercel Postgres, Neon, Supabase, RDS, self-hosted…
DATABASE_URL=postgresql://user:password@host:5432/global_harvest
